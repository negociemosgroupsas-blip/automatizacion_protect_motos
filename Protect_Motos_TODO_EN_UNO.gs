ight:700;\n  }\n  .filtro-chip button{\n    background:rgba(19,34,63,.1);\n    border:none;\n    color:var(--azul);\n    cursor:pointer;\n    font-weight:700;\n    font-size:.8rem;\n    line-height:1;\n    width:20px;\n    height:20px;\n    border-radius:50%;\n    display:inline-flex;\n    align-items:center;\n    justify-content:center;\n  }\n  .filtro-chip button:hover{background:rgba(19,34,63,.2);}\n\n  section.panel{\n    background:var(--tarjeta);\n    border-radius:14px;\n    border:1px solid var(--borde);\n    margin-bottom:22px;\n    overflow:hidden;\n  }\n  section.panel > .cabecera{\n    padding:14px 18px;\n    border-bottom:1px solid var(--borde);\n    display:flex;\n    align-items:center;\n    justify-content:space-between;\n    flex-wrap:wrap;\n    gap:8px;\n  }\n  section.panel > .cabecera h2{margin:0;font-size:1.02rem;color:var(--azul);}\n  section.panel > .cabecera .sub{font-size:.78rem;color:var(--texto-suave);}\n  .contenido-panel{padding:14px 18px;}\n\n  .cabecera-clic{cursor:pointer;user-select:none;}\n  .cabecera-clic:hover{background:#fafbfc;}\n\n  table{width:100%;border-collapse:collapse;font-size:.85rem;}\n  thead th{\n    text-align:left;\n    font-size:.72rem;\n    text-transform:uppercase;\n    letter-spacing:.3px;\n    color:var(--texto-suave);\n    padding:8px 10px;\n    border-bottom:2px solid var(--borde);\n    white-space:nowrap;\n  }\n  tbody td{padding:9px 10px;border-bottom:1px solid var(--borde);vertical-align:middle;}\n  tbody tr:hover{background:#fafbfc;}\n  .acciones-fila{display:flex;gap:6px;flex-wrap:wrap;}\n\n  .semaforo{\n    display:inline-flex;\n    align-items:center;\n    gap:6px;\n    padding:3px 9px;\n    border-radius:999px;\n    font-size:.72rem;\n    font-weight:700;\n    white-space:nowrap;\n  }\n  .semaforo.verde{background:var(--verde-bg);color:var(--verde);}\n  .semaforo.naranja{background:var(--naranja-bg);color:var(--naranja);}\n  .semaforo.rojo{background:var(--rojo-bg);color:var(--rojo);}\n  .semaforo.finalizado{background:#e9e9ef;color:#4b4f5a;}\n  .semaforo .punto{width:8px;height:8px;border-radius:50%;background:currentColor;}\n\n  .vacio{padding:26px;text-align:center;color:var(--texto-suave);font-size:.85rem;}\n\n  .caja-busqueda{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:12px;}\n  .caja-busqueda input{\n    flex:1;\n    min-width:220px;\n    padding:9px 12px;\n    border-radius:8px;\n    border:1px solid var(--borde);\n    font-size:.85rem;\n  }\n\n  .ficha-cliente{\n    display:grid;\n    grid-template-columns:repeat(auto-fit,minmax(160px,1fr));\n    gap:10px;\n    margin-bottom:16px;\n    padding:14px;\n    background:#f8f9fb;\n    border-radius:10px;\n  }\n  .ficha-cliente .campo .etiqueta{font-size:.68rem;text-transform:uppercase;color:var(--texto-suave);letter-spacing:.3px;}\n  .ficha-cliente .campo .valor{font-size:.9rem;font-weight:600;color:var(--texto);}\n\n  .tarjeta-poliza + .tarjeta-poliza{margin-top:22px;padding-top:22px;border-top:2px dashed var(--borde);}\n\n  .modal-fondo{\n    display:none;\n    position:fixed;inset:0;\n    background:rgba(19,34,63,.55);\n    align-items:center;justify-content:center;\n    z-index:100;\n    padding:16px;\n  }\n  .modal-fondo.abierto{display:flex;}\n  .modal{\n    background:#fff;\n    border-radius:14px;\n    width:100%;\n    max-width:420px;\n    padding:20px;\n    max-height:90vh;\n    overflow-y:auto;\n  }\n  .modal h3{margin:0 0 4px;color:var(--azul);}\n  .modal .sub{font-size:.8rem;color:var(--texto-suave);margin-bottom:14px;}\n  .campo-form{margin-bottom:12px;}\n  .campo-form label{display:block;font-size:.78rem;font-weight:600;margin-bottom:4px;color:var(--texto);}\n  .campo-form input, .campo-form select, .campo-form textarea{\n    width:100%;\n    padding:9px 10px;\n    border-radius:8px;\n    border:1px solid var(--borde);\n    font-size:.85rem;\n    font-family:inherit;\n  }\n  .modal-acciones{display:flex;gap:8px;justify-content:flex-end;margin-top:16px;}\n  .msg-modal{font-size:.8rem;padding:8px 10px;border-radius:8px;margin-top:10px;display:none;}\n  .msg-modal.ok{display:block;background:var(--verde-bg);color:var(--verde);}\n  .msg-modal.error{display:block;background:var(--rojo-bg);color:var(--rojo);}\n  .msg-modal.aviso{display:block;background:var(--naranja-bg);color:var(--naranja);}\n\n  footer{text-align:center;padding:20px;color:var(--texto-suave);font-size:.75rem;}\n\n  @media (max-width:640px){\n    header{padding:14px 16px;}\n    .barra-conector input{width:100%;max-width:100%;}\n    main{padding:12px;}\n    table, thead, tbody, th, td, tr{display:block;}\n    thead{display:none;}\n    tbody tr{\n      border:1px solid var(--borde);\n      border-radius:10px;\n      margin-bottom:10px;\n      padding:8px 10px;\n    }\n    tbody td{border:none;padding:5px 2px;display:flex;justify-content:space-between;gap:10px;}\n    tbody td::before{content:attr(data-etiqueta);font-weight:700;color:var(--texto-suave);font-size:.7rem;text-transform:uppercase;}\n  }\n  .barra-conector input,#btnGuardarUrl{display:none}\n</style>\n</head>\n<body>\n\n<header>\n  <div class=\"marca\">\n    <div>\n      <h1>Protect Motos · Sistema de Cobros</h1>\n      <p>Garantía suplementaria para motos — Medellín</p>\n    </div>\n  </div>\n  <div class=\"barra-conector\"><script>window.PM_URL_FIJA=\"__URL_CONECTOR__\";</script>\n    <input type=\"text\" id=\"inputUrlConector\" placeholder=\"Pega aquí la URL del conector (Apps Script)\">\n    <button class=\"btn btn-oro\" id=\"btnGuardarUrl\">Guardar</button>\n    <button class=\"btn btn-azul\" id=\"btnRecargar\">Actualizar datos</button>\n    <span style=\"color:#cbd3e6;font-size:.72rem;\">🔄 Se actualiza solo cada 1 min</span>\n  </div>\n</header>\n\n<main>\n  <div class=\"estado-conexion\" id=\"estadoConexion\"></div>\n\n  <div class=\"contadores\">\n    <div class=\"tarjeta-contador\" data-filtro=\"activos\" title=\"Ver clientes activos\"><div class=\"valor\" id=\"cActivos\">–</div><div class=\"etiqueta\">Activos</div></div>\n    <div class=\"tarjeta-contador\" data-filtro=\"cancelados\" title=\"Ver clientes cancelados\"><div class=\"valor\" id=\"cCancelados\">–</div><div class=\"etiqueta\">Cancelados</div></div>\n    <div class=\"tarjeta-contador\" data-filtro=\"finalizados\" title=\"Ver clientes finalizados\"><div class=\"valor\" id=\"cFinalizados\">–</div><div class=\"etiqueta\">Finalizados</div></div>\n    <div class=\"tarjeta-contador destacado\" data-filtro=\"pendientesHoy\" title=\"Ver pendientes de cobro hoy\"><div class=\"valor\" id=\"cPendientesHoy\">–</div><div class=\"etiqueta\">Pendientes de cobro hoy</div></div>\n    <div class=\"tarjeta-contador destacado\" data-filtro=\"totalPendiente\" title=\"Ver clientes con saldo pendiente\"><div class=\"valor\" id=\"cTotalPendiente\">–</div><div class=\"etiqueta\">Total pendiente por cobrar</div></div>\n    <div class=\"tarjeta-contador alerta\" data-filtro=\"renovar\" title=\"Ver pólizas por renovar\"><div class=\"valor\" id=\"cRenovar\">–</div><div class=\"etiqueta\">Pólizas por renovar (≤8 días)</div></div>\n  </div>\n\n  <section class=\"panel\" id=\"panelHistorial\">\n    <div class=\"cabecera\">\n      <h2>Historial del cliente</h2>\n      <span class=\"sub\">Busca por cédula, N° de contrato, placa o nombre</span>\n    </div>\n    <div class=\"contenido-panel\">\n      <div class=\"caja-busqueda\">\n        <input type=\"text\" id=\"inputBusqueda\" placeholder=\"Cédula, contrato, placa o nombre...\">\n        <button class=\"btn btn-azul btn-sm\" id=\"btnBuscar\">Buscar</button>\n      </div>\n      <div id=\"resultadoHistorial\"></div>\n    </div>\n  </section>\n\n  <section class=\"panel\" id=\"panelPagosMes\">\n    <div class=\"cabecera cabecera-clic\" id=\"cabeceraPagosMes\">\n      <h2>Pagos por mes</h2>\n      <span class=\"sub\" id=\"indicadorPagosMes\">Clic para ver ▾</span>\n    </div>\n    <div class=\"contenido-panel\" id=\"contenidoPagosMes\" style=\"display:none;\">\n      <div class=\"caja-busqueda\">\n        <input type=\"month\" id=\"inputMesPagos\">\n        <button class=\"btn btn-azul btn-sm\" id=\"btnBuscarMesPagos\">Ver pagos del mes</button>\n      </div>\n      <div id=\"resultadoPagosMes\"></div>\n    </div>\n  </section>\n\n  <section class=\"panel\" id=\"panelFiltro\" style=\"display:none;\">\n    <div class=\"cabecera\">\n      <h2>Listado filtrado</h2>\n      <div class=\"filtro-chip\">\n        <span id=\"chipFiltroTexto\">Mostrando: —</span>\n        <button id=\"btnQuitarFiltro\" title=\"Quitar filtro\">✕</button>\n      </div>\n    </div>\n    <div class=\"contenido-panel\">\n      <table id=\"tablaFiltro\">\n        <thead>\n          <tr>\n            <th>Cliente</th><th>Celular</th><th>Cédula</th><th>Placa</th><th>Contrato</th>\n            <th>Forma</th><th>Estado</th><th>Detalle</th><th>Acciones</th>\n          </tr>\n        </thead>\n        <tbody id=\"cuerpoFiltro\"></tbody>\n      </table>\n      <div class=\"vacio\" id=\"vacioFiltro\" style=\"display:none;\">No hay clientes en esta categoría.</div>\n    </div>\n  </section>\n\n  <section class=\"panel\">\n    <div class=\"cabecera\">\n      <h2>Cobros de hoy / pendientes</h2>\n      <span class=\"sub\">Solo clientes financiados y activos con cuota pendiente</span>\n    </div>\n    <div class=\"contenido-panel\">\n      <table id=\"tablaCobros\">\n        <thead>\n          <tr>\n            <th>Cliente</th><th>Celular</th><th>Placa</th><th>Contrato</th><th>Cuota</th>\n            <th>Vence</th><th>Valor</th><th>Atraso</th><th>Estado</th><th>Acciones</th>\n          </tr>\n        </thead>\n        <tbody id=\"cuerpoCobros\"></tbody>\n      </table>\n      <div class=\"vacio\" id=\"vacioCobros\" style=\"display:none;\">No hay datos cargados todavía.</div>\n    </div>\n  </section>\n\n  <section class=\"panel\">\n    <div class=\"cabecera\">\n      <h2>Por renovar</h2>\n      <span class=\"sub\">Vence en 8 días o menos (contado y financiado)</span>\n    </div>\n    <div class=\"contenido-panel\">\n      <table id=\"tablaRenovar\">\n        <thead>\n          <tr><th>Cliente</th><th>Celular</th><th>Placa</th><th>Contrato</th><th>Vence</th><th>Días</th><th>Acciones</th></tr>\n        </thead>\n        <tbody id=\"cuerpoRenovar\"></tbody>\n      </table>\n      <div class=\"vacio\" id=\"vacioRenovar\" style=\"display:none;\">No hay pólizas próximas a vencer.</div>\n    </div>\n  </section>\n\n</main>\n\n<footer>Protect Motos © <span id=\"anioActual\"></span> — Panel interno de cobros</footer>\n\n<!-- MODAL: registrar pago -->\n<div class=\"modal-fondo\" id=\"modalPago\">\n  <div class=\"modal\">\n    <h3>Registrar pago</h3>\n    <div class=\"sub\" id=\"pagoContexto\"></div>\n    <input type=\"hidden\" id=\"pagoContrato\">\n    <input type=\"hidden\" id=\"pagoCedula\">\n    <input type=\"hidden\" id=\"pagoCliente\">\n    <div class=\"campo-form\">\n      <label>N° de cuota (ej: 5, o \"4 a 6\" si paga varias)</label>\n      <input type=\"text\" id=\"pagoCuota\">\n    </div>\n    <div class=\"campo-form\">\n      <label>Valor pagado</label>\n      <input type=\"number\" id=\"pagoValor\" min=\"1\" step=\"1\">\n      <span class=\"sub\" id=\"pagoValorAyuda\" style=\"display:block;margin-top:4px;\"></span>\n    </div>\n    <div class=\"campo-form\">\n      <label>Fecha de pago</label>\n      <input type=\"date\" id=\"pagoFecha\">\n    </div>\n    <div class=\"campo-form\">\n      <label>Comprobante / nota</label>\n      <textarea id=\"pagoNota\" rows=\"2\" placeholder=\"N° de comprobante, observación...\"></textarea>\n    </div>\n    <div class=\"campo-form\">\n      <label>Registrado por</label>\n      <input type=\"text\" id=\"pagoRegistradoPor\" placeholder=\"Tu nombre\">\n    </div>\n    <div class=\"msg-modal\" id=\"msgPago\"></div>\n    <div class=\"modal-acciones\">\n      <button class=\"btn btn-gris\" id=\"btnCancelarPago\">Cancelar</button>\n      <button class=\"btn btn-verde\" id=\"btnGuardarPago\">Guardar pago</button>\n    </div>\n  </div>\n</div>\n\n<!-- MODAL: cancelar cliente -->\n<div class=\"modal-fondo\" id=\"modalCancelar\">\n  <div class=\"modal\">\n    <h3>Cancelar cliente</h3>\n    <div class=\"sub\" id=\"cancelarContexto\"></div>\n    <p style=\"font-size:.85rem;\">Esto marcará el estado del cliente como <strong>CANCELADO</strong> y dejará de aparecer en cobros. Esta acción se puede revertir manualmente desde la hoja si te equivocas.</p>\n    <input type=\"hidden\" id=\"cancelarContrato\">\n    <div class=\"msg-modal\" id=\"msgCancelar\"></div>\n    <div class=\"modal-acciones\">\n      <button class=\"btn btn-gris\" id=\"btnCerrarCancelar\">Volver</button>\n      <button class=\"btn btn-rojo\" id=\"btnConfirmarCancelar\">Sí, cancelar cliente</button>\n    </div>\n  </div>\n</div>\n\n<script>\n(function(){\n  \"use strict\";\n\n  // ==================== CONFIGURACIÓN ====================\n  var TOKEN = 'PM-COBROS-2026';\n  // Pega aquí la URL del conector (termina en /exec) para que este HTML funcione en cualquier computador sin configurarla.\n  var URL_CONECTOR_FIJA = '';\n  var CLAVE_URL = 'pm_cobros_url_conector';\n  var UMBRAL_DIAS_ROJO = 5; // días de atraso para pasar de naranja a rojo\n  var DIAS_AVISO_RENOVACION = 8;\n  var TIMEOUT_JSONP_MS = 60000; // tu hoja tiene muchos contratos: dale tiempo suficiente para cargar\n  var AUTO_REFRESCO_MS = 60000; // cada cuánto se refresca solo el panel (1 minuto)\n\n  // Datos de la cuenta para pagos, se incluyen en el mensaje de WhatsApp de cobro.\n  var DATOS_PAGO = {\n    banco: 'Bancolombia',\n    tipoCuenta: 'Ahorros',\n    numeroCuenta: '33100007298',\n    titular: 'Negociemos Group SAS',\n    telefono: '3128806873'\n  };\n\n  var estado = {\n    contratos: [],\n    pagos: [],\n    gestiones: [],\n    urlConector: (window.PM_URL_FIJA || localStorage.getItem(CLAVE_URL) || ''),\n    filtroActivo: null\n  };\n\n  // ==================== UTILIDADES DE FECHA / DINERO ====================\n  function hoy(){\n    var d = new Date();\n    d.setHours(0,0,0,0);\n    return d;\n  }\n\n  function parsearISO(iso){\n    if(!iso) return null;\n    var partes = iso.split('-');\n    if(partes.length!==3) return null;\n    var d = new Date(Number(partes[0]), Number(partes[1])-1, Number(partes[2]));\n    d.setHours(0,0,0,0);\n    return d;\n  }\n\n  function formatoFechaCO(d){\n    if(!d) return '—';\n    return d.getDate()+'/'+(d.getMonth()+1)+'/'+d.getFullYear();\n  }\n\n  function formatoFechaInput(d){\n    if(!d) return '';\n    var m = ('0'+(d.getMonth()+1)).slice(-2);\n    var dd = ('0'+d.getDate()).slice(-2);\n    return d.getFullYear()+'-'+m+'-'+dd;\n  }\n\n  function formatoDinero(valor){\n    valor = Math.round(Number(valor)||0);\n    var texto = valor.toString();\n    var signo = '';\n    if(texto[0]==='-'){ signo='-'; texto = texto.slice(1); }\n    var conPuntos = texto.replace(/\\B(?=(\\d{3})+(?!\\d))/g,'.');\n    return '$'+signo+conPuntos;\n  }\n\n  function addMonths(date, n){\n    var d = new Date(date.getFullYear(), date.getMonth()+n, 1);\n    var ultimoDia = new Date(d.getFullYear(), d.getMonth()+1, 0).getDate();\n    d.setDate(Math.min(date.getDate(), ultimoDia));\n    d.setHours(0,0,0,0);\n    return d;\n  }\n\n  function diferenciaDias(a,b){\n    return Math.round((a.getTime()-b.getTime())/86400000);\n  }\n\n  function extraerNumerosCuota(texto){\n    texto = String(texto||'').trim();\n    var numeros = [];\n    var rangoTexto = texto.match(/^(\\d+)\\s*a\\s*(\\d+)$/i);\n    if(rangoTexto){\n      var x=parseInt(rangoTexto[1],10), y=parseInt(rangoTexto[2],10);\n      for(var k=x;k<=y;k++) numeros.push(k);\n      return numeros;\n    }\n    var partes = texto.replace(/,/g,' ').split(/\\s+/).filter(function(p){return p!=='';});\n    for(var i=0;i<partes.length;i++){\n      var parte = partes[i];\n      var rango = parte.match(/^(\\d+)-(\\d+)$/);\n      if(rango){\n        var a=parseInt(rango[1],10), b=parseInt(rango[2],10);\n        for(var n=a;n<=b;n++) numeros.push(n);\n      } else if(/^\\d+$/.test(parte)){\n        numeros.push(parseInt(parte,10));\n      }\n    }\n    return numeros;\n  }\n\n  // ==================== JSONP ====================\n  var contadorJsonp = 0;\n  function llamarConector(params){\n    return new Promise(function(resolve, reject){\n      if(!estado.urlConector){\n        reject(new Error('Primero guarda la URL del conector.'));\n        return;\n      }\n      contadorJsonp++;\n      var nombreCallback = 'pm_cb_'+Date.now()+'_'+contadorJsonp;\n      var script = document.createElement('script');\n      var terminado = false;\n\n      var temporizador = setTimeout(function(){\n        if(terminado) return;\n        terminado = true;\n        limpiar();\n        reject(new Error('El conector no respondió a tiempo. Revisa la URL o tu conexión.'));\n      }, TIMEOUT_JSONP_MS);\n\n      function limpiar(){\n        clearTimeout(temporizador);\n        delete window[nombreCallback];\n        if(script.parentNode) script.parentNode.removeChild(script);\n      }\n\n      window[nombreCallback] = function(respuesta){\n        if(terminado) return;\n        terminado = true;\n        limpiar();\n        resolve(respuesta);\n      };\n\n      script.onerror = function(){\n        if(terminado) return;\n        terminado = true;\n        limpiar();\n        reject(new Error('No se pudo contactar el conector. Revisa la URL.'));\n      };\n\n      var query = 'token='+encodeURIComponent(TOKEN)+'&callback='+nombreCallback;\n      Object.keys(params||{}).forEach(function(clave){\n        query += '&'+encodeURIComponent(clave)+'='+encodeURIComponent(params[clave]);\n      });\n\n      var separador = estado.urlConector.indexOf('?')===-1 ? '?' : '&';\n      script.src = estado.urlConector + separador + query;\n      document.body.appendChild(script);\n    });\n  }\n\n  // ==================== ESTADO DE CONEXIÓN (UI) ====================\n  var elEstadoConexion = document.getElementById('estadoConexion');\n  var temporizadorEstadoConexion = null;\n  function mostrarEstado(tipo, texto){\n    elEstadoConexion.className = 'estado-conexion '+tipo;\n    elEstadoConexion.textContent = texto;\n    if(temporizadorEstadoConexion){\n      clearTimeout(temporizadorEstadoConexion);\n      temporizadorEstadoConexion = null;\n    }\n    // Los mensajes de éxito se borran solos; los de error o carga se quedan visibles.\n    if(tipo==='ok'){\n      temporizadorEstadoConexion = setTimeout(function(){\n        elEstadoConexion.className = 'estado-conexion';\n        elEstadoConexion.textContent = '';\n      }, 6000);\n    }\n  }\n\n  // ==================== CARGA DE DATOS ====================\n  var enCarga = false;\n\n  function hayModalAbierto(){\n    return document.querySelector('.modal-fondo.abierto') !== null;\n  }\n\n  // Si una carga de datos que venía lenta desde el servidor responde justo\n  // después de haber marcado \"Ya cobré hoy\", puede traer una foto de la hoja\n  // tomada ANTES de ese registro y \"borrarlo\" al reemplazar estado.gestiones.\n  // Para evitar que el cliente reaparezca por esto, conservamos las gestiones\n  // de HOY que ya teníamos localmente si el servidor todavía no las trae.\n  function fusionarGestionesDeHoy(gestionesServidor){\n    var hoyISO = formatoFechaInput(hoy());\n    var yaEnServidor = {};\n    gestionesServidor.forEach(function(g){\n      if(g.fechaGestionISO===hoyISO) yaEnServidor[g.contrato] = true;\n    });\n    (estado.gestiones||[]).forEach(function(g){\n      if(g.fechaGestionISO===hoyISO && !yaEnServidor[g.contrato]){\n        gestionesServidor.push(g);\n      }\n    });\n    return gestionesServidor;\n  }\n\n  // Mismo problema, pero con \"Registrar pago\": si una carga lenta trae una\n  // foto de \"Pagos\" tomada antes de guardar el pago, lo conservamos hasta\n  // que el propio servidor lo confirme (entonces dejamos de vigilarlo).\n  var pagosLocalesPendientes = [];\n  function claveDePago(p){ return p.contrato+'|'+p.cuota+'|'+p.fechaPagoISO+'|'+p.valorPagado; }\n  function fusionarPagosLocales(pagosServidor){\n    var yaEnServidor = {};\n    pagosServidor.forEach(function(p){ yaEnServidor[claveDePago(p)] = true; });\n    pagosLocalesPendientes = pagosLocalesPendientes.filter(function(p){\n      if(yaEnServidor[claveDePago(p)]) return false; // el servidor ya lo tiene: dejamos de vigilarlo\n      pagosServidor.push(p);\n      return true;\n    });\n    return pagosServidor;\n  }\n\n  // Y con \"Cancelar cliente\": si una carga lenta trae el estado viejo,\n  // reaplicamos la cancelación local hasta que el servidor la confirme.\n  var estadosLocalesPendientes = {}; // contrato -> nuevoEstado\n  function reaplicarEstadosLocales(contratos){\n    contratos.forEach(function(c){\n      var nuevoEstado = estadosLocalesPendientes[c.contrato];\n      if(!nuevoEstado) return;\n      if(c.estado===nuevoEstado){\n        delete estadosLocalesPendientes[c.contrato]; // el servidor ya lo confirmó\n      } else {\n        c.estado = nuevoEstado;\n      }\n    });\n  }\n\n  function cargarDatos(silencioso){\n    if(enCarga) return Promise.resolve();\n    enCarga = true;\n    if(!silencioso){\n      mostrarEstado('cargando','Cargando datos desde Google Sheets... (puede tardar hasta 30-40 segundos si tienes muchos contratos, por favor espera)');\n    }\n    return llamarConector({action:'datos'}).then(function(resp){\n      if(!resp.ok){\n        mostrarEstado('error', resp.error || 'Error desconocido al cargar datos.');\n        return;\n      }\n      estado.contratos = resp.contratos || [];\n      reaplicarEstadosLocales(estado.contratos);\n      estado.pagos = fusionarPagosLocales(resp.pagos || []);\n      estado.gestiones = fusionarGestionesDeHoy(resp.gestiones || []);\n      var hora = new Date().toLocaleTimeString('es-CO');\n      mostrarEstado('ok', 'Datos actualizados · '+estado.contratos.length+' contratos · '+estado.pagos.length+' pagos registrados · Última sincronización: '+hora+'.');\n      renderizarTodo();\n      if(document.getElementById('inputBusqueda').value.trim()){\n        buscarCliente();\n      }\n      if(pagosMesEstaAbierto()){\n        buscarPagosPorMes();\n      }\n    }).catch(function(err){\n      mostrarEstado('error', err.message);\n    }).finally(function(){\n      enCarga = false;\n    });\n  }\n\n  // ==================== ACTUALIZACIÓN AUTOMÁTICA ====================\n  var temporizadorAutoRefresco = null;\n\n  function iniciarAutoRefresco(){\n    if(temporizadorAutoRefresco) clearInterval(temporizadorAutoRefresco);\n    temporizadorAutoRefresco = setInterval(function(){\n      if(!estado.urlConector || enCarga || hayModalAbierto()) return;\n      cargarDatos(true);\n    }, AUTO_REFRESCO_MS);\n  }\n\n  // ==================== LÓGICA DE NEGOCIO ====================\n  // Contratos ya gestionados HOY (botón \"Ya cobré hoy\"): no es un pago, solo\n  // indica que ya se hizo el contacto, para no repetirlo el mismo día.\n  function construirSetGestionadosHoy(){\n    var hoyISO = formatoFechaInput(hoy());\n    var set = {};\n    estado.gestiones.forEach(function(g){\n      if(g.fechaGestionISO===hoyISO) set[g.contrato] = true;\n    });\n    return set;\n  }\n\n  function construirMapaPagos(){\n    var mapa = {}; // contrato -> {cuotasPagadas:Set, totalPagado:number, pagos:[]}\n    estado.pagos.forEach(function(p){\n      if(!mapa[p.contrato]){\n        mapa[p.contrato] = { cuotasPagadas: {}, totalPagado:0, pagos:[] };\n      }\n      var registro = mapa[p.contrato];\n      registro.totalPagado += Number(p.valorPagado)||0;\n      registro.pagos.push(p);\n      extraerNumerosCuota(p.cuota).forEach(function(n){ registro.cuotasPagadas[n]=true; });\n    });\n    return mapa;\n  }\n\n  function calcularEstadoCuotas(contrato, mapaPagos){\n    var registro = mapaPagos[contrato.contrato] || {cuotasPagadas:{}, totalPagado:0, pagos:[]};\n    var pagadasSet = registro.cuotasPagadas;\n    var numPagadas = Object.keys(pagadasSet).length;\n    var plazo = contrato.plazo || 0;\n    var faltantes = Math.max(0, plazo - numPagadas);\n    var saldo = faltantes * (contrato.valorCuota||0);\n\n    var cuotaPendiente = null;\n    if(contrato.forma==='FINANCIADO' && contrato.fechaFirmaISO && plazo>0){\n      var firma = parsearISO(contrato.fechaFirmaISO);\n      var hoyD = hoy();\n      for(var n=1;n<=plazo;n++){\n        if(pagadasSet[n]) continue;\n        var vence = addMonths(firma, n);\n        if(vence.getTime() <= hoyD.getTime()){\n          cuotaPendiente = { numero:n, fechaVence:vence, diasAtraso: diferenciaDias(hoyD, vence) };\n          break;\n        } else {\n          break; // la próxima cuota aún no vence: no hay pendiente todavía\n        }\n      }\n    }\n\n    return {\n      cuotasPagadas: numPagadas,\n      faltantes: faltantes,\n      saldo: saldo,\n      totalPagado: registro.totalPagado,\n      pagos: registro.pagos,\n      cuotaPendiente: cuotaPendiente,\n      completado: plazo>0 && numPagadas>=plazo\n    };\n  }\n\n  function semaforoDe(contrato, infoCuotas){\n    if(contrato.estado==='FINALIZADO' || infoCuotas.completado){\n      return {clase:'finalizado', texto:'Finalizado'};\n    }\n    if(!infoCuotas.cuotaPendiente){\n      return {clase:'verde', texto:'Al día'};\n    }\n    var dias = infoCuotas.cuotaPendiente.diasAtraso;\n    if(dias >= UMBRAL_DIAS_ROJO) return {clase:'rojo', texto:'Atrasado ('+dias+'d)'};\n    if(dias >= 0) return {clase:'naranja', texto: dias===0 ? 'Cobrar hoy' : 'Atraso leve ('+dias+'d)'};\n    return {clase:'verde', texto:'Al día'};\n  }\n\n  // Marca automáticamente como FINALIZADO en el servidor si ya pagó todo y sigue ACTIVO\n  function sincronizarFinalizados(mapaPagos){\n    var pendientesDeMarcar = [];\n    estado.contratos.forEach(function(c){\n      if(c.forma!=='FINANCIADO' || c.estado!=='ACTIVO') return;\n      var info = calcularEstadoCuotas(c, mapaPagos);\n      if(info.completado) pendientesDeMarcar.push(c.contrato);\n    });\n    if(pendientesDeMarcar.length===0) return Promise.resolve();\n    var promesas = pendientesDeMarcar.map(function(contratoId){\n      return llamarConector({action:'estado', contrato:contratoId, nuevoEstado:'FINALIZADO'}).catch(function(){});\n    });\n    return Promise.all(promesas).then(function(){\n      pendientesDeMarcar.forEach(function(id){\n        var c = estado.contratos.find(function(x){return x.contrato===id;});\n        if(c) c.estado='FINALIZADO';\n      });\n    });\n  }\n\n  // ==================== RENDERIZADO ====================\n  function renderizarTodo(){\n    var mapaPagos = construirMapaPagos();\n    sincronizarFinalizados(mapaPagos).then(function(){\n      renderizarVistas(mapaPagos);\n    });\n  }\n\n  // Vuelve a dibujar todo con los datos que ya están en memoria, sin\n  // pedirle nada nuevo al servidor (para que \"Ya cobré hoy\" se sienta\n  // instantáneo y se pueda pasar rápido al siguiente cliente).\n  function renderizarVistas(mapaPagos){\n    renderizarContadores(mapaPagos);\n    renderizarCobros(mapaPagos);\n    renderizarRenovaciones();\n    renderizarFiltro(mapaPagos);\n  }\n\n  function renderizarContadores(mapaPagos){\n    var activos=0, cancelados=0, finalizados=0, pendientesHoy=0, totalPendiente=0, porRenovar=0;\n    var hoyD = hoy();\n    var gestionadosHoy = construirSetGestionadosHoy();\n\n    estado.contratos.forEach(function(c){\n      if(c.estado==='ACTIVO') activos++;\n      else if(c.estado==='CANCELADO') cancelados++;\n      else if(c.estado==='FINALIZADO') finalizados++;\n\n      if(c.forma==='FINANCIADO' && c.estado==='ACTIVO'){\n        var info = calcularEstadoCuotas(c, mapaPagos);\n        if(info.cuotaPendiente){\n          // \"Total pendiente\" es dinero que deben (siempre cuenta).\n          // \"Pendientes de cobro hoy\" es la cola de gestión del día (no cuenta si ya se gestionó hoy).\n          totalPendiente += c.valorCuota||0;\n          if(!gestionadosHoy[c.contrato]) pendientesHoy++;\n        }\n      }\n\n      if(c.estado!=='CANCELADO' && c.finISO){\n        var fin = parsearISO(c.finISO);\n        if(fin){\n          var dias = diferenciaDias(fin, hoyD);\n          if(dias<=DIAS_AVISO_RENOVACION) porRenovar++;\n        }\n      }\n    });\n\n    document.getElementById('cActivos').textContent = activos;\n    document.getElementById('cCancelados').textContent = cancelados;\n    document.getElementById('cFinalizados').textContent = finalizados;\n    document.getElementById('cPendientesHoy').textContent = pendientesHoy;\n    document.getElementById('cTotalPendiente').textContent = formatoDinero(totalPendiente);\n    document.getElementById('cRenovar').textContent = porRenovar;\n  }\n\n  function renderizarCobros(mapaPagos){\n    var cuerpo = document.getElementById('cuerpoCobros');\n    var vacio = document.getElementById('vacioCobros');\n    cuerpo.innerHTML='';\n\n    var gestionadosHoy = construirSetGestionadosHoy();\n    var lista = [];\n    var huboGestionados = false;\n    estado.contratos.forEach(function(c){\n      if(c.forma!=='FINANCIADO' || c.estado!=='ACTIVO') return;\n      var info = calcularEstadoCuotas(c, mapaPagos);\n      if(!info.cuotaPendiente) return;\n      if(gestionadosHoy[c.contrato]){ huboGestionados = true; return; } // ya se le hizo la gestión hoy\n      lista.push({contrato:c, info:info});\n    });\n\n    // Los de hoy primero; los más atrasados van quedando al final (a la cola)\n    lista.sort(function(a,b){ return a.info.cuotaPendiente.diasAtraso - b.info.cuotaPendiente.diasAtraso; });\n\n    if(lista.length===0){\n      vacio.style.display='block';\n      if(!estado.contratos.length){\n        vacio.textContent = 'No hay datos cargados todavía.';\n      } else if(huboGestionados){\n        vacio.textContent = '✓ Ya gestionaste a todos los pendientes de hoy. ¡Buen trabajo!';\n      } else {\n        vacio.textContent = 'No hay cobros pendientes en este momento. ¡Vas al día!';\n      }\n      return;\n    }\n    vacio.style.display='none';\n\n    lista.forEach(function(item){\n      var c = item.contrato, info = item.info;\n      var sem = semaforoDe(c, info);\n      var tr = document.createElement('tr');\n      tr.innerHTML =\n        '<td data-etiqueta=\"Cliente\"><strong>'+escapeHtml(c.cliente)+'</strong><br><span style=\"color:var(--texto-suave);font-size:.75rem;\">'+escapeHtml(c.cedula)+'</span></td>'+\n        '<td data-etiqueta=\"Celular\">'+escapeHtml(c.celular)+'</td>'+\n        '<td data-etiqueta=\"Placa\">'+escapeHtml(c.placa)+'</td>'+\n        '<td data-etiqueta=\"Contrato\">'+escapeHtml(c.contrato)+'</td>'+\n        '<td data-etiqueta=\"Cuota\">#'+info.cuotaPendiente.numero+' de '+c.plazo+'</td>'+\n        '<td data-etiqueta=\"Vence\">'+formatoFechaCO(info.cuotaPendiente.fechaVence)+'</td>'+\n        '<td data-etiqueta=\"Valor\">'+formatoDinero(c.valorCuota)+'</td>'+\n        '<td data-etiqueta=\"Atraso\">'+(info.cuotaPendiente.diasAtraso===0?'Hoy':info.cuotaPendiente.diasAtraso+' día(s)')+'</td>'+\n        '<td data-etiqueta=\"Estado\"><span class=\"semaforo '+sem.clase+'\"><span class=\"punto\"></span>'+sem.texto+'</span></td>'+\n        '<td data-etiqueta=\"Acciones\"><div class=\"acciones-fila\">'+\n          '<button class=\"btn btn-verde btn-sm\" data-accion=\"whatsapp-cobro\">WhatsApp</button>'+\n          '<button class=\"btn btn-azul btn-sm\" data-accion=\"registrar-pago\">Registrar pago</button>'+\n          '<button class=\"btn btn-gris btn-sm\" data-accion=\"gestion-hoy\">Ya cobré hoy</button>'+\n          '<button class=\"btn btn-rojo btn-sm\" data-accion=\"cancelar\">Cancelar</button>'+\n        '</div></td>';\n\n      tr.querySelector('[data-accion=\"whatsapp-cobro\"]').addEventListener('click', function(){\n        abrirWhatsAppCobro(c, info);\n      });\n      tr.querySelector('[data-accion=\"registrar-pago\"]').addEventListener('click', function(){\n        abrirModalPago(c, info);\n      });\n      tr.querySelector('[data-accion=\"gestion-hoy\"]').addEventListener('click', function(e){\n        marcarGestionHoy(c, e.currentTarget);\n      });\n      tr.querySelector('[data-accion=\"cancelar\"]').addEventListener('click', function(){\n        abrirModalCancelar(c);\n      });\n\n      cuerpo.appendChild(tr);\n    });\n  }\n\n  function renderizarRenovaciones(){\n    var cuerpo = document.getElementById('cuerpoRenovar');\n    var vacio = document.getElementById('vacioRenovar');\n    cuerpo.innerHTML='';\n\n    var hoyD = hoy();\n    var lista = [];\n    estado.contratos.forEach(function(c){\n      if(c.estado==='CANCELADO' || !c.finISO) return;\n      var fin = parsearISO(c.finISO);\n      if(!fin) return;\n      var dias = diferenciaDias(fin, hoyD);\n      if(dias<=DIAS_AVISO_RENOVACION){\n        lista.push({contrato:c, fin:fin, dias:dias});\n      }\n    });\n\n    lista.sort(function(a,b){ return a.dias-b.dias; });\n\n    if(lista.length===0){\n      vacio.style.display='block';\n      return;\n    }\n    vacio.style.display='none';\n\n    lista.forEach(function(item){\n      var c = item.contrato;\n      var etiquetaDias = item.dias<0 ? ('Vencido hace '+Math.abs(item.dias)+'d') : (item.dias===0?'Vence hoy':item.dias+' día(s)');\n      var tr = document.createElement('tr');\n      tr.innerHTML =\n        '<td data-etiqueta=\"Cliente\"><strong>'+escapeHtml(c.cliente)+'</strong></td>'+\n        '<td data-etiqueta=\"Celular\">'+escapeHtml(c.celular)+'</td>'+\n        '<td data-etiqueta=\"Placa\">'+escapeHtml(c.placa)+'</td>'+\n        '<td data-etiqueta=\"Contrato\">'+escapeHtml(c.contrato)+'</td>'+\n        '<td data-etiqueta=\"Vence\">'+formatoFechaCO(item.fin)+'</td>'+\n        '<td data-etiqueta=\"Días\"><span class=\"semaforo '+(item.dias<0?'rojo':item.dias<=3?'naranja':'verde')+'\"><span class=\"punto\"></span>'+etiquetaDias+'</span></td>'+\n        '<td data-etiqueta=\"Acciones\"><div class=\"acciones-fila\">'+\n          '<button class=\"btn btn-verde btn-sm\" data-accion=\"whatsapp-renovar\">WhatsApp</button>'+\n          '<button class=\"btn btn-azul btn-sm\" data-accion=\"acepto-renovacion\">Acepto renovación</button>'+\n          '<button class=\"btn btn-rojo btn-sm\" data-accion=\"no-acepto-renovacion\">No acepto renovación</button>'+\n        '</div></td>';\n\n      tr.querySelector('[data-accion=\"whatsapp-renovar\"]').addEventListener('click', function(){\n        abrirWhatsAppRenovacion(c, item.fin);\n      });\n      tr.querySelector('[data-accion=\"acepto-renovacion\"]').addEventListener('click', function(e){\n        marcarRenovacion(c, true, e.currentTarget);\n      });\n      tr.querySelector('[data-accion=\"no-acepto-renovacion\"]').addEventListener('click', function(e){\n        marcarRenovacion(c, false, e.currentTarget);\n      });\n\n      cuerpo.appendChild(tr);\n    });\n  }\n\n  // ==================== FILTROS DESDE LOS INDICADORES ====================\n  var FILTROS_INFO = {\n    activos:        { etiqueta: 'Activos' },\n    cancelados:     { etiqueta: 'Cancelados' },\n    finalizados:    { etiqueta: 'Finalizados' },\n    pendientesHoy:  { etiqueta: 'Pendientes de cobro hoy' },\n    totalPendiente: { etiqueta: 'Clientes con saldo pendiente' },\n    renovar:        { etiqueta: 'Pólizas por renovar (≤8 días)' }\n  };\n\n  function construirFilasFiltro(tipo, mapaPagos){\n    var hoyD = hoy();\n    var filas = [];\n    var gestionadosHoy = construirSetGestionadosHoy();\n\n    if(tipo==='activos' || tipo==='cancelados' || tipo==='finalizados'){\n      var estadoBuscado = tipo==='activos' ? 'ACTIVO' : (tipo==='cancelados' ? 'CANCELADO' : 'FINALIZADO');\n      estado.contratos.forEach(function(c){\n        if(c.estado!==estadoBuscado) return;\n        var detalle = 'Vence póliza: '+(c.fin || '—');\n        if(c.forma==='FINANCIADO') detalle += ' · Cuota: '+formatoDinero(c.valorCuota);\n        filas.push({c:c, detalle:detalle, semaforo:null, tipoAcciones:'historial'});\n      });\n    } else if(tipo==='pendientesHoy' || tipo==='totalPendiente'){\n      estado.contratos.forEach(function(c){\n        if(c.forma!=='FINANCIADO' || c.estado!=='ACTIVO') return;\n        var info = calcularEstadoCuotas(c, mapaPagos);\n        if(!info.cuotaPendiente) return;\n        // \"Pendientes de cobro hoy\" es la cola de gestión: si ya se gestionó hoy, no sale.\n        // \"Total pendiente\" es dinero que deben: sigue apareciendo, solo se marca como gestionado.\n        var yaGestionado = !!gestionadosHoy[c.contrato];\n        if(tipo==='pendientesHoy' && yaGestionado) return;\n        var sem = semaforoDe(c, info);\n        var atrasoTexto = info.cuotaPendiente.diasAtraso===0 ? 'Hoy' : info.cuotaPendiente.diasAtraso+' día(s) de atraso';\n        var detalle = 'Contrato firmado: '+c.fechaFirma+' · Cuota #'+info.cuotaPendiente.numero+' de '+c.plazo+' · Fecha de pago: '+formatoFechaCO(info.cuotaPendiente.fechaVence)+' · Valor a pagar: '+formatoDinero(c.valorCuota)+' · '+atrasoTexto;\n        filas.push({c:c, detalle:detalle, semaforo:sem, tipoAcciones:'cobro', info:info, gestionadoHoy:yaGestionado});\n      });\n      // Los de hoy primero; los más atrasados van quedando al final (a la cola)\n      filas.sort(function(a,b){ return a.info.cuotaPendiente.diasAtraso - b.info.cuotaPendiente.diasAtraso; });\n    } else if(tipo==='renovar'){\n      estado.contratos.forEach(function(c){\n        if(c.estado==='CANCELADO' || !c.finISO) return;\n        var fin = parsearISO(c.finISO);\n        if(!fin) return;\n        var dias = diferenciaDias(fin, hoyD);\n        if(dias>DIAS_AVISO_RENOVACION) return;\n        var etiquetaDias = dias<0 ? ('Vencido hace '+Math.abs(dias)+'d') : (dias===0?'Vence hoy':dias+' día(s)');\n        var sem = { clase: dias<0?'rojo':(dias<=3?'naranja':'verde'), texto: etiquetaDias };\n        filas.push({c:c, detalle:'Vence: '+formatoFechaCO(fin), semaforo:sem, tipoAcciones:'renovar', fin:fin, dias:dias});\n      });\n      filas.sort(function(a,b){ return a.dias-b.dias; });\n    }\n\n    return filas;\n  }\n\n  function crearBotonAccion(texto, clase, manejador){\n    var boton = document.createElement('button');\n    boton.className = 'btn btn-sm '+clase;\n    boton.textContent = texto;\n    boton.addEventListener('click', manejador);\n    return boton;\n  }\n\n  function irAHistorial(c){\n    document.getElementById('inputBusqueda').value = c.contrato || c.cedula || c.placa || '';\n    buscarCliente();\n    var panelHist = document.getElementById('panelHistorial');\n    if(panelHist) panelHist.scrollIntoView({behavior:'smooth', block:'start'});\n  }\n\n  function renderizarFiltro(mapaPagos){\n    var panel = document.getElementById('panelFiltro');\n    if(!estado.filtroActivo){\n      panel.style.display = 'none';\n      return;\n    }\n    panel.style.display = '';\n    document.getElementById('chipFiltroTexto').textContent = 'Mostrando: '+FILTROS_INFO[estado.filtroActivo].etiqueta;\n\n    var filas = construirFilasFiltro(estado.filtroActivo, mapaPagos);\n    var cuerpo = document.getElementById('cuerpoFiltro');\n    var vacio = document.getElementById('vacioFiltro');\n    cuerpo.innerHTML = '';\n\n    if(filas.length===0){\n      vacio.style.display = 'block';\n      return;\n    }\n    vacio.style.display = 'none';\n\n    filas.forEach(function(item){\n      var c = item.c;\n      var semHtml = item.semaforo\n        ? '<span class=\"semaforo '+item.semaforo.clase+'\"><span class=\"punto\"></span>'+item.semaforo.texto+'</span>'\n        : escapeHtml(c.estado);\n      var tr = document.createElement('tr');\n      tr.innerHTML =\n        '<td data-etiqueta=\"Cliente\"><strong>'+escapeHtml(c.cliente)+'</strong></td>'+\n        '<td data-etiqueta=\"Celular\">'+escapeHtml(c.celular)+'</td>'+\n        '<td data-etiqueta=\"Cédula\">'+escapeHtml(c.cedula)+'</td>'+\n        '<td data-etiqueta=\"Placa\">'+escapeHtml(c.placa)+'</td>'+\n        '<td data-etiqueta=\"Contrato\">'+escapeHtml(c.contrato)+'</td>'+\n        '<td data-etiqueta=\"Forma\">'+escapeHtml(c.forma)+'</td>'+\n        '<td data-etiqueta=\"Estado\">'+semHtml+'</td>'+\n        '<td data-etiqueta=\"Detalle\">'+escapeHtml(item.detalle)+'</td>'+\n        '<td data-etiqueta=\"Acciones\"><div class=\"acciones-fila\" data-acciones></div></td>';\n\n      var celdaAcciones = tr.querySelector('[data-acciones]');\n      if(item.tipoAcciones==='cobro'){\n        celdaAcciones.appendChild(crearBotonAccion('WhatsApp','btn-verde', function(){ abrirWhatsAppCobro(c, item.info); }));\n        celdaAcciones.appendChild(crearBotonAccion('Registrar pago','btn-azul', function(){ abrirModalPago(c, item.info); }));\n        if(item.gestionadoHoy){\n          var etiquetaGestion = document.createElement('span');\n          etiquetaGestion.className = 'semaforo finalizado';\n          etiquetaGestion.innerHTML = '<span class=\"punto\"></span>Ya gestionado hoy';\n          celdaAcciones.appendChild(etiquetaGestion);\n        } else {\n          celdaAcciones.appendChild(crearBotonAccion('Ya cobré hoy','btn-gris', function(e){ marcarGestionHoy(c, e.currentTarget); }));\n        }\n        celdaAcciones.appendChild(crearBotonAccion('Cancelar','btn-rojo', function(){ abrirModalCancelar(c); }));\n      } else if(item.tipoAcciones==='renovar'){\n        celdaAcciones.appendChild(crearBotonAccion('WhatsApp','btn-verde', function(){ abrirWhatsAppRenovacion(c, item.fin); }));\n      } else {\n        celdaAcciones.appendChild(crearBotonAccion('Ver historial','btn-azul', function(){ irAHistorial(c); }));\n      }\n\n      cuerpo.appendChild(tr);\n    });\n  }\n\n  function actualizarTarjetasActivas(){\n    document.querySelectorAll('.tarjeta-contador[data-filtro]').forEach(function(el){\n      el.classList.toggle('activo', el.getAttribute('data-filtro')===estado.filtroActivo);\n    });\n  }\n\n  function aplicarFiltro(tipo){\n    estado.filtroActivo = (estado.filtroActivo===tipo) ? null : tipo;\n    actualizarTarjetasActivas();\n    renderizarFiltro(construirMapaPagos());\n    if(estado.filtroActivo){\n      document.getElementById('panelFiltro').scrollIntoView({behavior:'smooth', block:'start'});\n    }\n  }\n\n  function limpiarFiltro(){\n    estado.filtroActivo = null;\n    actualizarTarjetasActivas();\n    renderizarFiltro(construirMapaPagos());\n  }\n\n  document.querySelectorAll('.tarjeta-contador[data-filtro]').forEach(function(el){\n    el.addEventListener('click', function(){ aplicarFiltro(el.getAttribute('data-filtro')); });\n  });\n  document.getElementById('btnQuitarFiltro').addEventListener('click', limpiarFiltro);\n\n  function escapeHtml(texto){\n    var div = document.createElement('div');\n    div.textContent = texto==null?'':String(texto);\n    return div.innerHTML;\n  }\n\n  // ==================== WHATSAPP ====================\n  function numeroWhatsApp(celular){\n    var digitos = String(celular||'').replace(/\\D/g,'');\n    if(digitos.indexOf('57')===0 && digitos.length>10) return digitos;\n    return '57'+digitos;\n  }\n\n  function abrirWhatsAppCobro(c, info){\n    var mensaje;\n    if(info && info.cuotaPendiente){\n      mensaje =\n        'Hola, '+c.cliente+'\\n'+\n        'Te escribimos de Protect Motos, la póliza de tu motocicleta, para recordarte que tienes pendiente la cuota #'+info.cuotaPendiente.numero+' de tu póliza.\\n\\n'+\n        'Valor de la cuota: '+formatoDinero(c.valorCuota)+'\\n'+\n        'Fecha de pago: '+formatoFechaCO(info.cuotaPendiente.fechaVence)+'\\n\\n'+\n        'Puedes realizar el pago a la siguiente cuenta:\\n'+\n        'Banco: '+DATOS_PAGO.banco+'\\n'+\n        'Cuenta de '+DATOS_PAGO.tipoCuenta+' N°: '+DATOS_PAGO.numeroCuenta+'\\n'+\n        'Titular: '+DATOS_PAGO.titular+'\\n'+\n        'Teléfono: '+DATOS_PAGO.telefono+'\\n\\n'+\n        'Cuando realices el pago, por favor envíanos el comprobante por este medio para poder registrarlo.\\n\\n'+\n        '¡Muchas gracias!';\n    } else {\n      mensaje =\n        'Hola, '+c.cliente+'\\n'+\n        'Te escribimos de Protect Motos, la póliza de tu motocicleta, para saber cómo va todo con tu cuota.\\n\\n'+\n        'Si deseas realizar el pago, puedes hacerlo a la siguiente cuenta:\\n'+\n        'Banco: '+DATOS_PAGO.banco+'\\n'+\n        'Cuenta de '+DATOS_PAGO.tipoCuenta+' N°: '+DATOS_PAGO.numeroCuenta+'\\n'+\n        'Titular: '+DATOS_PAGO.titular+'\\n'+\n        'Teléfono: '+DATOS_PAGO.telefono+'\\n\\n'+\n        'Cuando realices el pago, por favor envíanos el comprobante por este medio para poder registrarlo.\\n\\n'+\n        '¡Muchas gracias!';\n    }\n    var url = 'https://wa.me/'+numeroWhatsApp(c.celular)+'?text='+encodeURIComponent(mensaje);\n    window.open(url,'_blank');\n  }\n\n  function abrirWhatsAppRenovacion(c, fechaFin){\n    var mensaje =\n      'Hola, '+c.cliente+' 😊\\n'+\n      'Te escribimos de Protect Motos porque tu garantía suplementaria para tu moto de placa '+c.placa+' está por vencer el '+formatoFechaCO(fechaFin)+'.\\n\\n'+\n      'Queremos ayudarte a renovarla a tiempo para que sigas protegido sin interrupciones.\\n\\n'+\n      '¿Quieres que te contemos las opciones de renovación? 💙💛';\n    var url = 'https://wa.me/'+numeroWhatsApp(c.celular)+'?text='+encodeURIComponent(mensaje);\n    window.open(url,'_blank');\n  }\n\n  // ==================== MODAL: REGISTRAR PAGO ====================\n  var modalPago = document.getElementById('modalPago');\n  var contratoEnPago = null;\n\n  // Si el cliente ya tiene un pago registrado este mes, devuelve ese pago\n  // (el más reciente), para poder avisar antes de registrar otro.\n  function pagoDeEsteMes(contrato){\n    var mesActual = formatoFechaInput(new Date()).slice(0,7);\n    var pagosDelMes = estado.pagos.filter(function(p){\n      return p.contrato===contrato && (p.fechaPagoISO||'').slice(0,7)===mesActual;\n    });\n    if(pagosDelMes.length===0) return null;\n    pagosDelMes.sort(function(a,b){ return (b.fechaPagoISO||'').localeCompare(a.fechaPagoISO||''); });\n    return pagosDelMes[0];\n  }\n\n  function abrirModalPago(c, info){\n    contratoEnPago = c;\n    document.getElementById('pagoContexto').textContent = c.cliente+' · Contrato '+c.contrato+' · Placa '+c.placa;\n    document.getElementById('pagoContrato').value = c.contrato;\n    document.getElementById('pagoCedula').value = c.cedula;\n    document.getElementById('pagoCliente').value = c.cliente;\n    document.getElementById('pagoCuota').value = info && info.cuotaPendiente ? info.cuotaPendiente.numero : '';\n    document.getElementById('pagoValor').value = c.valorCuota || '';\n    document.getElementById('pagoValorAyuda').textContent = '';\n    document.getElementById('pagoFecha').value = formatoFechaInput(new Date());\n    document.getElementById('pagoNota').value = '';\n    notaEsAutomatica = true;\n    var registradoPrevio = localStorage.getItem('pm_cobros_registrado_por')||'';\n    document.getElementById('pagoRegistradoPor').value = registradoPrevio;\n\n    var msg = document.getElementById('msgPago');\n    var pagoExistente = pagoDeEsteMes(c.contrato);\n    if(pagoExistente){\n      msg.className = 'msg-modal aviso';\n      msg.textContent = '⚠ Este cliente ya tiene un pago registrado este mes: cuota '+pagoExistente.cuota+' por '+formatoDinero(pagoExistente.valorPagado)+' el '+pagoExistente.fechaPago+'. Revisa antes de registrar otro.';\n    } else {\n      msg.className = 'msg-modal';\n      msg.textContent = '';\n    }\n    modalPago.classList.add('abierto');\n  }\n\n  function cerrarModalPago(){\n    modalPago.classList.remove('abierto');\n    contratoEnPago = null;\n  }\n\n  // A qué mes(es) corresponde cada número de cuota, según la fecha de firma\n  // del contrato (cuota N vence N meses después de la firma). Ej: \"Septiembre\n  // de 2026\" o, si son varias, \"Septiembre y Octubre de 2026\".\n  function textoMesesDeCuotas(numeros){\n    if(!contratoEnPago || !contratoEnPago.fechaFirmaISO || numeros.length===0) return '';\n    var firma = parsearISO(contratoEnPago.fechaFirmaISO);\n    if(!firma) return '';\n    var fechas = numeros.map(function(n){ return addMonths(firma, n); });\n    var mismoAnio = fechas.every(function(f){ return f.getFullYear()===fechas[0].getFullYear(); });\n    var nombres = fechas.map(function(f){\n      return NOMBRES_MES[f.getMonth()] + (mismoAnio ? '' : ' de '+f.getFullYear());\n    });\n    var texto = nombres.length===1 ? nombres[0] : nombres.slice(0,-1).join(', ')+' y '+nombres[nombres.length-1];\n    return mismoAnio ? texto+' de '+fechas[0].getFullYear() : texto;\n  }\n\n  // Si escribe varias cuotas (\"3 a 4\"), recalcula el valor sugerido\n  // (N cuotas × valor de la cuota) para que no quede guardado el valor\n  // de una sola cuota cuando en realidad pagó varias, y deja escrito en\n  // la nota a qué mes(es) corresponde, para que quede claro en la hoja.\n  var notaEsAutomatica = true;\n  document.getElementById('pagoNota').addEventListener('input', function(){ notaEsAutomatica = false; });\n\n  function actualizarValorSugeridoPago(){\n    var ayuda = document.getElementById('pagoValorAyuda');\n    if(!contratoEnPago || !contratoEnPago.valorCuota){ ayuda.textContent=''; return; }\n    var numeros = extraerNumerosCuota(document.getElementById('pagoCuota').value.trim());\n    if(numeros.length===0){ ayuda.textContent=''; return; }\n    var total = numeros.length * contratoEnPago.valorCuota;\n    document.getElementById('pagoValor').value = total;\n\n    var textoMeses = textoMesesDeCuotas(numeros);\n    if(textoMeses && notaEsAutomatica){\n      var campoNota = document.getElementById('pagoNota');\n      campoNota.value = 'Pago cuota'+(numeros.length>1?'s ':' ')+numeros.join(', ')+' — '+textoMeses;\n      notaEsAutomatica = true; // ese cambio lo hicimos nosotros, no cuenta como edición manual\n    }\n\n    ayuda.textContent = numeros.length>1\n      ? 'Calculado para '+numeros.length+' cuotas ('+formatoDinero(contratoEnPago.valorCuota)+' c/u = '+formatoDinero(total)+'). Ajústalo si el valor real fue distinto.'\n      : '';\n  }\n  document.getElementById('pagoCuota').addEventListener('input', actualizarValorSugeridoPago);\n\n  document.getElementById('btnCancelarPago').addEventListener('click', cerrarModalPago);\n\n  document.getElementById('btnGuardarPago').addEventListener('click', function(){\n    var contrato = document.getElementById('pagoContrato').value;\n    var cedula = document.getElementById('pagoCedula').value;\n    var cliente = document.getElementById('pagoCliente').value;\n    var cuota = document.getElementById('pagoCuota').value.trim();\n    var valor = document.getElementById('pagoValor').value;\n    var fecha = document.getElementById('pagoFecha').value;\n    var nota = document.getElementById('pagoNota').value.trim();\n    var registradoPor = document.getElementById('pagoRegistradoPor').value.trim();\n    var msg = document.getElementById('msgPago');\n\n    if(!cuota){ msg.className='msg-modal error'; msg.textContent='Escribe el número de cuota.'; return; }\n    if(!valor || Number(valor)<=0){ msg.className='msg-modal error'; msg.textContent='El valor debe ser mayor a 0.'; return; }\n    if(!fecha){ msg.className='msg-modal error'; msg.textContent='Selecciona la fecha de pago.'; return; }\n\n    localStorage.setItem('pm_cobros_registrado_por', registradoPor);\n\n    var boton = document.getElementById('btnGuardarPago');\n    boton.disabled = true;\n    boton.textContent = 'Guardando...';\n\n    llamarConector({\n      action:'registrarPago',\n      contrato:contrato, cedula:cedula, cliente:cliente,\n      cuota:cuota, valor:valor, fecha:fecha, nota:nota, registradoPor:registradoPor\n    }).then(function(resp){\n      boton.disabled=false; boton.textContent='Guardar pago';\n      if(resp.ok){\n        msg.className='msg-modal ok';\n        msg.textContent='Pago registrado correctamente.';\n        // Actualización al instante: no esperar a recargar todo para que\n        // el cliente salga de \"Cobros de hoy\" si ya no tiene cuota pendiente.\n        var fechaPagoDate = parsearISO(fecha) || new Date();\n        var nuevoPago = {\n          fechaPago: formatoFechaCO(fechaPagoDate),\n          fechaPagoISO: fecha,\n          contrato: contrato, cedula: cedula, cliente: cliente,\n          cuota: cuota, valorPagado: Number(valor), nota: nota, registradoPor: registradoPor\n        };\n        estado.pagos.push(nuevoPago);\n        pagosLocalesPendientes.push(nuevoPago);\n        renderizarVistas(construirMapaPagos());\n        if(pagosMesEstaAbierto()){\n          buscarPagosPorMes();\n        }\n        setTimeout(function(){\n          cerrarModalPago();\n          cargarDatos();\n        }, 900);\n      } else {\n        msg.className='msg-modal error';\n        msg.textContent = resp.error || 'No se pudo registrar el pago.';\n      }\n    }).catch(function(err){\n      boton.disabled=false; boton.textContent='Guardar pago';\n      msg.className='msg-modal error';\n      msg.textContent = err.message;\n    });\n  });\n\n  // ==================== MODAL: CANCELAR CLIENTE ====================\n  var modalCancelar = document.getElementById('modalCancelar');\n\n  function abrirModalCancelar(c){\n    document.getElementById('cancelarContexto').textContent = c.cliente+' · Contrato '+c.contrato+' · Placa '+c.placa;\n    document.getElementById('cancelarContrato').value = c.contrato;\n    document.getElementById('msgCancelar').className='msg-modal';\n    document.getElementById('msgCancelar').textContent='';\n    modalCancelar.classList.add('abierto');\n  }\n\n  function cerrarModalCancelar(){\n    modalCancelar.classList.remove('abierto');\n  }\n\n  document.getElementById('btnCerrarCancelar').addEventListener('click', cerrarModalCancelar);\n\n  document.getElementById('btnConfirmarCancelar').addEventListener('click', function(){\n    var contrato = document.getElementById('cancelarContrato').value;\n    var msg = document.getElementById('msgCancelar');\n    var boton = document.getElementById('btnConfirmarCancelar');\n    boton.disabled = true;\n    boton.textContent = 'Cancelando...';\n\n    llamarConector({action:'estado', contrato:contrato, nuevoEstado:'CANCELADO'}).then(function(resp){\n      boton.disabled=false; boton.textContent='Sí, cancelar cliente';\n      if(resp.ok){\n        msg.className='msg-modal ok';\n        msg.textContent='Cliente cancelado.';\n        // Actualización al instante: que salga de \"Cobros de hoy\" sin\n        // esperar a que termine de recargar todo.\n        var contratoCancelado = estado.contratos.find(function(x){ return x.contrato===contrato; });\n        if(contratoCancelado) contratoCancelado.estado = 'CANCELADO';\n        estadosLocalesPendientes[contrato] = 'CANCELADO';\n        renderizarVistas(construirMapaPagos());\n        setTimeout(function(){\n          cerrarModalCancelar();\n          cargarDatos();\n        }, 800);\n      } else {\n        msg.className='msg-modal error';\n        msg.textContent = resp.error || 'No se pudo cancelar.';\n      }\n    }).catch(function(err){\n      boton.disabled=false; boton.textContent='Sí, cancelar cliente';\n      msg.className='msg-modal error';\n      msg.textContent = err.message;\n    });\n  });\n\n  // ==================== GESTIÓN DE COBRO (Ya cobré hoy) ====================\n  // No cambia el estado del cliente ni registra ningún pago: solo deja\n  // constancia de que hoy ya se hizo el contacto, para que no vuelva a\n  // salir en la lista de pendientes de hoy (sí vuelve mañana si sigue debiendo).\n  function marcarGestionHoy(c, boton){\n    var registradoPor = localStorage.getItem('pm_cobros_registrado_por') || '';\n    var textoOriginal = boton ? boton.textContent : null;\n    if(boton){ boton.disabled = true; boton.textContent = 'Guardando...'; }\n\n    llamarConector({\n      action:'registrarGestion',\n      contrato:c.contrato, cedula:c.cedula, cliente:c.cliente, registradoPor:registradoPor\n    }).then(function(resp){\n      if(!resp.ok){\n        if(boton){ boton.disabled = false; boton.textContent = textoOriginal; }\n        var mensajeError = resp.error || 'No se pudo registrar la gestión.';\n        mostrarEstado('error', mensajeError);\n        window.alert('No se pudo registrar la gestión de '+c.cliente+':\\n\\n'+mensajeError);\n        return;\n      }\n      var hoyD = hoy();\n      if(!Array.isArray(estado.gestiones)) estado.gestiones = [];\n      estado.gestiones.push({\n        fechaGestion: formatoFechaCO(hoyD),\n        fechaGestionISO: formatoFechaInput(hoyD),\n        contrato: c.contrato,\n        cedula: c.cedula,\n        cliente: c.cliente,\n        accion: 'Cobro realizado',\n        registradoPor: registradoPor\n      });\n      mostrarEstado('ok', '✓ Gestión registrada para '+c.cliente+'. No volverá a salir en la lista de hoy.');\n      renderizarVistas(construirMapaPagos());\n      if(document.getElementById('inputBusqueda').value.trim()){\n        buscarCliente();\n      }\n    }).catch(function(err){\n      if(boton){ boton.disabled = false; boton.textContent = textoOriginal; }\n      mostrarEstado('error', err.message);\n      window.alert('No se pudo registrar la gestión de '+c.cliente+':\\n\\n'+err.message);\n    });\n  }\n\n  // ==================== POR RENOVAR: ACEPTA / NO ACEPTA ====================\n  // Sea cual sea la respuesta, el contrato que está por vencer se cierra\n  // (queda CANCELADO): si acepta, el nuevo contrato se registra aparte;\n  // si no acepta, simplemente no continúa. En ambos casos deja de salir\n  // en \"Por renovar\", igual que un cliente gestionado deja de salir en\n  // \"Cobros de hoy\".\n  function marcarRenovacion(c, acepto, boton){\n    var textoAccion = acepto ? 'Renovación aceptada' : 'Renovación no aceptada';\n    var pregunta = acepto\n      ? '¿Confirmas que '+c.cliente+' ACEPTÓ la renovación?\\n\\nEl contrato '+c.contrato+' quedará marcado como CANCELADO (el contrato nuevo se registra aparte).'\n      : '¿Confirmas que '+c.cliente+' NO aceptó la renovación?\\n\\nEl contrato '+c.contrato+' quedará marcado como CANCELADO.';\n    if(!window.confirm(pregunta)) return;\n\n    var registradoPor = localStorage.getItem('pm_cobros_registrado_por') || '';\n    var textoOriginal = boton ? boton.textContent : null;\n    if(boton){ boton.disabled = true; boton.textContent = 'Guardando...'; }\n\n    llamarConector({action:'estado', contrato:c.contrato, nuevoEstado:'CANCELADO'}).then(function(resp){\n      if(!resp.ok){\n        if(boton){ boton.disabled = false; boton.textContent = textoOriginal; }\n        var mensajeError = resp.error || 'No se pudo actualizar el estado.';\n        mostrarEstado('error', mensajeError);\n        window.alert('No se pudo registrar la renovación de '+c.cliente+':\\n\\n'+mensajeError);\n        return;\n      }\n      c.estado = 'CANCELADO';\n      estadosLocalesPendientes[c.contrato] = 'CANCELADO';\n      mostrarEstado('ok', '✓ '+textoAccion+' — '+c.cliente+'. Contrato '+c.contrato+' marcado como CANCELADO.');\n      renderizarVistas(construirMapaPagos());\n      if(document.getElementById('inputBusqueda').value.trim()){\n        buscarCliente();\n      }\n\n      // Deja constancia en el historial de gestiones (no bloquea la vista si falla).\n      llamarConector({\n        action:'registrarGestion', contrato:c.contrato, cedula:c.cedula, cliente:c.cliente,\n        registradoPor:registradoPor, accion:textoAccion\n      }).then(function(respGestion){\n        if(!respGestion.ok) return;\n        if(!Array.isArray(estado.gestiones)) estado.gestiones = [];\n        var hoyD = hoy();\n        estado.gestiones.push({\n          fechaGestion: formatoFechaCO(hoyD),\n          fechaGestionISO: formatoFechaInput(hoyD),\n          contrato: c.contrato, cedula: c.cedula, cliente: c.cliente,\n          accion: textoAccion, registradoPor: registradoPor\n        });\n        if(document.getElementById('inputBusqueda').value.trim()){\n          buscarCliente();\n        }\n      }).catch(function(){});\n    }).catch(function(err){\n      if(boton){ boton.disabled = false; boton.textContent = textoOriginal; }\n      mostrarEstado('error', err.message);\n      window.alert('No se pudo registrar la renovación de '+c.cliente+':\\n\\n'+err.message);\n    });\n  }\n\n  // ==================== HISTORIAL ====================\n  function buscarCliente(){\n    var termino = document.getElementById('inputBusqueda').value.trim().toLowerCase();\n    var contenedor = document.getElementById('resultadoHistorial');\n    contenedor.innerHTML='';\n    if(!termino){ return; }\n\n    var encontrados = estado.contratos.filter(function(c){\n      return c.cedula.toLowerCase()===termino ||\n             c.contrato.toLowerCase()===termino ||\n             c.placa.toLowerCase()===termino ||\n             c.cliente.toLowerCase().indexOf(termino)!==-1;\n    });\n\n    if(encontrados.length===0){\n      contenedor.innerHTML = '<div class=\"vacio\">No se encontró ningún cliente con ese dato.</div>';\n      return;\n    }\n\n    // Más reciente primero, por si el cliente tiene varias pólizas (renovaciones de años distintos)\n    encontrados.sort(function(a,b){\n      return (b.fechaFirmaISO||'').localeCompare(a.fechaFirmaISO||'');\n    });\n\n    var mapaPagos = construirMapaPagos();\n\n    if(encontrados.length>1){\n      var aviso = document.createElement('div');\n      aviso.className = 'sub';\n      aviso.style.marginBottom = '12px';\n      aviso.textContent = 'Este cliente tiene '+encontrados.length+' pólizas registradas:';\n      contenedor.appendChild(aviso);\n    }\n\n    encontrados.forEach(function(encontrado){\n      renderizarFichaPoliza(contenedor, encontrado, mapaPagos, encontrados.length);\n    });\n  }\n\n  function renderizarFichaPoliza(contenedor, encontrado, mapaPagos, totalPolizas){\n    var info = calcularEstadoCuotas(encontrado, mapaPagos);\n    var sem = semaforoDe(encontrado, info);\n    var tarjeta = document.createElement('div');\n    tarjeta.className = 'tarjeta-poliza';\n\n    var html = '';\n    if(totalPolizas>1){\n      html += '<h3 style=\"margin:0 0 10px;color:var(--azul);font-size:.95rem;\">Póliza · Contrato '+escapeHtml(encontrado.contrato)+' ('+escapeHtml(encontrado.fechaFirma)+')</h3>';\n    }\n    html += '<div class=\"ficha-cliente\">'+\n      campoFicha('Cliente', encontrado.cliente)+\n      campoFicha('Cédula', encontrado.cedula)+\n      campoFicha('Placa', encontrado.placa)+\n      campoFicha('Contrato', encontrado.contrato)+\n      campoFicha('Forma', encontrado.forma)+\n      campoFicha('Estado', encontrado.estado)+\n      campoFicha('Fecha firma', encontrado.fechaFirma)+\n      campoFicha('Vence póliza', encontrado.fin)+\n      campoFicha('Valor cuota', formatoDinero(encontrado.valorCuota))+\n      campoFicha('Plazo', encontrado.plazo+' cuotas')+\n      campoFicha('Cuotas pagadas', info.cuotasPagadas+' / '+encontrado.plazo)+\n      campoFicha('Saldo pendiente', formatoDinero(info.saldo))+\n      campoFicha('Celular', encontrado.celular)+\n    '</div>';\n\n    html += '<div style=\"margin-bottom:10px;\"><span class=\"semaforo '+sem.clase+'\"><span class=\"punto\"></span>'+sem.texto+'</span></div>';\n\n    if(encontrado.estado==='ACTIVO'){\n      html += '<div class=\"acciones-fila\" style=\"margin-bottom:16px;\">';\n      if(encontrado.forma==='FINANCIADO'){\n        html += '<button class=\"btn btn-verde btn-sm\" data-accion=\"whatsapp-cobro\">WhatsApp</button>';\n        html += '<button class=\"btn btn-azul btn-sm\" data-accion=\"registrar-pago\">Registrar pago</button>';\n        html += '<button class=\"btn btn-gris btn-sm\" data-accion=\"gestion-hoy\">Ya cobré hoy</button>';\n      }\n      html += '<button class=\"btn btn-rojo btn-sm\" data-accion=\"cancelar\">Cancelar cliente</button>';\n      html += '</div>';\n    } else if(encontrado.estado==='FINALIZADO'){\n      html += '<div class=\"acciones-fila\" style=\"margin-bottom:16px;\">';\n      html += '<button class=\"btn btn-verde btn-sm\" data-accion=\"whatsapp-renovar-ficha\">WhatsApp</button>';\n      html += '<button class=\"btn btn-azul btn-sm\" data-accion=\"acepto-renovacion-ficha\">Acepto renovación</button>';\n      html += '<button class=\"btn btn-rojo btn-sm\" data-accion=\"no-acepto-renovacion-ficha\">No acepto renovación</button>';\n      html += '</div>';\n    }\n\n    if(info.pagos.length===0){\n      html += '<div class=\"vacio\">Este cliente aún no tiene pagos registrados.</div>';\n    } else {\n      var pagosOrdenados = info.pagos.slice().sort(function(a,b){\n        return (a.fechaPagoISO||'').localeCompare(b.fechaPagoISO||'');\n      });\n      html += '<table><thead><tr><th>Fecha de pago</th><th>Cuota</th><th>Valor</th><th>Comprobante / nota</th><th>Registrado por</th><th>Puntualidad</th></tr></thead><tbody>';\n      pagosOrdenados.forEach(function(p){\n        var puntualidad = '—';\n        var numeros = extraerNumerosCuota(p.cuota);\n        if(numeros.length && encontrado.fechaFirmaISO){\n          var firma = parsearISO(encontrado.fechaFirmaISO);\n          var venceCuota = addMonths(firma, numeros[0]);\n          var fechaPago = parsearISO(p.fechaPagoISO);\n          if(fechaPago){\n            var dif = diferenciaDias(fechaPago, venceCuota);\n            if(dif<0) puntualidad = 'Antes de tiempo';\n            else if(dif===0) puntualidad = 'El día';\n            else puntualidad = 'Tarde ('+dif+'d)';\n          }\n        }\n        html += '<tr>'+\n          '<td data-etiqueta=\"Fecha\">'+escapeHtml(p.fechaPago)+'</td>'+\n          '<td data-etiqueta=\"Cuota\">'+escapeHtml(p.cuota)+'</td>'+\n          '<td data-etiqueta=\"Valor\">'+formatoDinero(p.valorPagado)+'</td>'+\n          '<td data-etiqueta=\"Nota\">'+escapeHtml(p.nota)+'</td>'+\n          '<td data-etiqueta=\"Registrado por\">'+escapeHtml(p.registradoPor)+'</td>'+\n          '<td data-etiqueta=\"Puntualidad\">'+puntualidad+'</td>'+\n        '</tr>';\n      });\n      html += '</tbody></table>';\n    }\n\n    var gestionesCliente = estado.gestiones.filter(function(g){ return g.contrato===encontrado.contrato; });\n    html += '<h3 style=\"margin:18px 0 8px;color:var(--azul);font-size:.95rem;\">Historial de gestiones de cobro</h3>';\n    if(gestionesCliente.length===0){\n      html += '<div class=\"vacio\">Todavía no se ha registrado ninguna gestión de cobro para este cliente.</div>';\n    } else {\n      var gestionesOrdenadas = gestionesCliente.slice().sort(function(a,b){\n        return (a.fechaGestionISO||'').localeCompare(b.fechaGestionISO||'');\n      });\n      html += '<table><thead><tr><th>Fecha de gestión</th><th>Acción</th><th>Registrado por</th></tr></thead><tbody>';\n      gestionesOrdenadas.forEach(function(g){\n        html += '<tr>'+\n          '<td data-etiqueta=\"Fecha\">'+escapeHtml(g.fechaGestion)+'</td>'+\n          '<td data-etiqueta=\"Acción\">'+escapeHtml(g.accion)+'</td>'+\n          '<td data-etiqueta=\"Registrado por\">'+escapeHtml(g.registradoPor)+'</td>'+\n        '</tr>';\n      });\n      html += '</tbody></table>';\n    }\n\n    tarjeta.innerHTML = html;\n    contenedor.appendChild(tarjeta);\n\n    var accWhatsapp = tarjeta.querySelector('[data-accion=\"whatsapp-cobro\"]');\n    if(accWhatsapp) accWhatsapp.addEventListener('click', function(){ abrirWhatsAppCobro(encontrado, info); });\n    var accPago = tarjeta.querySelector('[data-accion=\"registrar-pago\"]');\n    if(accPago) accPago.addEventListener('click', function(){ abrirModalPago(encontrado, info); });\n    var accGestion = tarjeta.querySelector('[data-accion=\"gestion-hoy\"]');\n    if(accGestion) accGestion.addEventListener('click', function(){ marcarGestionHoy(encontrado, accGestion); });\n    var accCancelar = tarjeta.querySelector('[data-accion=\"cancelar\"]');\n    if(accCancelar) accCancelar.addEventListener('click', function(){ abrirModalCancelar(encontrado); });\n\n    var accWhatsappRenovar = tarjeta.querySelector('[data-accion=\"whatsapp-renovar-ficha\"]');\n    if(accWhatsappRenovar) accWhatsappRenovar.addEventListener('click', function(){\n      var fin = parsearISO(encontrado.finISO);\n      abrirWhatsAppRenovacion(encontrado, fin);\n    });\n    var accAceptoRenovacion = tarjeta.querySelector('[data-accion=\"acepto-renovacion-ficha\"]');\n    if(accAceptoRenovacion) accAceptoRenovacion.addEventListener('click', function(e){\n      marcarRenovacion(encontrado, true, e.currentTarget);\n    });\n    var accNoAceptoRenovacion = tarjeta.querySelector('[data-accion=\"no-acepto-renovacion-ficha\"]');\n    if(accNoAceptoRenovacion) accNoAceptoRenovacion.addEventListener('click', function(e){\n      marcarRenovacion(encontrado, false, e.currentTarget);\n    });\n  }\n\n  function campoFicha(etiqueta, valor){\n    return '<div class=\"campo\"><div class=\"etiqueta\">'+etiqueta+'</div><div class=\"valor\">'+escapeHtml(valor)+'</div></div>';\n  }\n\n  document.getElementById('btnBuscar').addEventListener('click', buscarCliente);\n  document.getElementById('inputBusqueda').addEventListener('keydown', function(e){\n    if(e.key==='Enter') buscarCliente();\n  });\n\n  // ==================== PAGOS POR MES ====================\n  var NOMBRES_MES = ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];\n  function etiquetaDeMes(mesInput){\n    var partes = mesInput.split('-');\n    var idx = parseInt(partes[1],10)-1;\n    return (NOMBRES_MES[idx]||partes[1])+' de '+partes[0];\n  }\n\n  function buscarPagosPorMes(){\n    var mes = document.getElementById('inputMesPagos').value; // formato \"AAAA-MM\"\n    var contenedor = document.getElementById('resultadoPagosMes');\n    contenedor.innerHTML = '';\n    if(!mes) return;\n\n    var pagosDelMes = estado.pagos.filter(function(p){\n      return (p.fechaPagoISO||'').slice(0,7) === mes;\n    }).sort(function(a,b){\n      return (a.fechaPagoISO||'').localeCompare(b.fechaPagoISO||'');\n    });\n\n    if(pagosDelMes.length===0){\n      contenedor.innerHTML = '<div class=\"vacio\">No hay pagos registrados en '+etiquetaDeMes(mes)+'.</div>';\n      return;\n    }\n\n    var total = 0;\n    var clientesUnicos = {};\n    pagosDelMes.forEach(function(p){\n      total += Number(p.valorPagado)||0;\n      clientesUnicos[p.contrato] = true;\n    });\n\n    var html = '<div class=\"ficha-cliente\">'+\n      campoFicha('Mes', etiquetaDeMes(mes))+\n      campoFicha('Pagos registrados', String(pagosDelMes.length))+\n      campoFicha('Clientes distintos', String(Object.keys(clientesUnicos).length))+\n      campoFicha('Total cobrado', formatoDinero(total))+\n    '</div>';\n\n    html += '<table><thead><tr><th>Fecha de pago</th><th>Cliente</th><th>Cédula</th><th>Contrato</th><th>Cuota</th><th>Valor</th><th>Registrado por</th></tr></thead><tbody>';\n    pagosDelMes.forEach(function(p){\n      html += '<tr>'+\n        '<td data-etiqueta=\"Fecha\">'+escapeHtml(p.fechaPago)+'</td>'+\n        '<td data-etiqueta=\"Cliente\">'+escapeHtml(p.cliente)+'</td>'+\n        '<td data-etiqueta=\"Cédula\">'+escapeHtml(p.cedula)+'</td>'+\n        '<td data-etiqueta=\"Contrato\">'+escapeHtml(p.contrato)+'</td>'+\n        '<td data-etiqueta=\"Cuota\">'+escapeHtml(p.cuota)+'</td>'+\n        '<td data-etiqueta=\"Valor\">'+formatoDinero(p.valorPagado)+'</td>'+\n        '<td data-etiqueta=\"Registrado por\">'+escapeHtml(p.registradoPor)+'</td>'+\n      '</tr>';\n    });\n    html += '</tbody></table>';\n\n    contenedor.innerHTML = html;\n  }\n\n  // El mes queda preseleccionado en el actual (para no tener que elegirlo),\n  // pero el panel arranca oculto: no se busca nada hasta que se abra.\n  document.getElementById('inputMesPagos').value = formatoFechaInput(new Date()).slice(0,7);\n\n  function pagosMesEstaAbierto(){\n    return document.getElementById('contenidoPagosMes').style.display !== 'none';\n  }\n\n  document.getElementById('cabeceraPagosMes').addEventListener('click', function(){\n    var contenido = document.getElementById('contenidoPagosMes');\n    var indicador = document.getElementById('indicadorPagosMes');\n    var abrir = contenido.style.display === 'none';\n    contenido.style.display = abrir ? '' : 'none';\n    indicador.textContent = abrir ? 'Clic para ocultar ▴' : 'Clic para ver ▾';\n    if(abrir) buscarPagosPorMes();\n  });\n\n  document.getElementById('btnBuscarMesPagos').addEventListener('click', buscarPagosPorMes);\n  document.getElementById('inputMesPagos').addEventListener('keydown', function(e){\n    if(e.key==='Enter') buscarPagosPorMes();\n  });\n\n  // ==================== CONFIGURACIÓN DE URL ====================\n  var inputUrl = document.getElementById('inputUrlConector');\n  inputUrl.value = estado.urlConector;\n\n  document.getElementById('btnGuardarUrl').addEventListener('click', function(){\n    estado.urlConector = inputUrl.value.trim();\n    localStorage.setItem(CLAVE_URL, estado.urlConector);\n    cargarDatos();\n    iniciarAutoRefresco();\n  });\n\n  document.getElementById('btnRecargar').addEventListener('click', function(){\n    cargarDatos();\n  });\n\n  document.getElementById('anioActual').textContent = new Date().getFullYear();\n\n  // ==================== INICIO ====================\n  if(estado.urlConector){\n    cargarDatos();\n    iniciarAutoRefresco();\n  } else {\n    mostrarEstado('error', 'Pega la URL de tu conector (Apps Script publicado como Aplicación web) y presiona Guardar.');\n  }\n})();\n</script>\n</body>\n</html>\n";
